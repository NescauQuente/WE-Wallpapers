# Only the wallpaper projects live in this repository: everything else in this
# workspace (other projects, .env) stays out. The CasaOS mod that runs them is
# its own repository (UsuarioDeJava/CasaMODs).
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CLAUDE.md
!/plexus-wallpaper/
!/star-wallpaper/
!/lyric-wallpaper/
!/dev/

__pycache__/
node_modules/
Thumbs.db
.DS_Store
